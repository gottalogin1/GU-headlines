# Caddy is the front door of GU Headlines. It answers visitors on port 80
# (http) and port 443 (https), and passes each request on to the website
# (the "web" container, port 8000 inside Docker's own network).
#
# SITE_ADDRESS comes from SITE_DOMAIN in .env (see docker-compose.yml):
#
#   SITE_DOMAIN empty                 ->  :80
#     Plain http:// on port 80, for any address that reaches the server,
#     such as its IP address. No certificate.
#
#   SITE_DOMAIN=guamheadlines.com     ->  guamheadlines.com
#     https:// for that domain. Caddy gets a free certificate from Let's
#     Encrypt (or ZeroSSL) and renews it by itself. http:// visits are sent
#     on to https://. The domain must already point at this server, and
#     ports 80 and 443 must be open. See docs/maintenance.md.
#
# You do not need to change this file. Change SITE_DOMAIN in .env, then run
# "docker compose up -d".

{$SITE_ADDRESS} {
	# The website. Caddy tells it each visitor's address and whether the
	# visit came over https (the X-Forwarded-For and X-Forwarded-Proto
	# headers).
	reverse_proxy web:8000

	# The largest request the site takes is the guide editor's form with two
	# photos, about 16 MB. Larger ones are refused here (413), so nobody can
	# tie up the website by sending it a huge upload.
	request_body {
		max_size 20MB
	}

	# Do not tell visitors which web server software runs the site.
	header {
		-Server
		-Via
	}
}

# The webmail of your own mail server (see docs/email-server.md).
#
# WEBMAIL_ADDRESS comes from MAIL_HOSTNAME in .env:
#
#   MAIL_HOSTNAME empty                    ->  http://mail.invalid
#     A name that does not exist, so nobody reaches this part, and Caddy
#     asks for no certificate.
#
#   MAIL_HOSTNAME=mail.guamheadlines.com   ->  mail.guamheadlines.com
#     https:// for that name, with the webmail (Roundcube). The mail server
#     uses the same certificate for its own encrypted connections, so the
#     name must point at this server, like SITE_DOMAIN.
{$WEBMAIL_ADDRESS} {
	# Only from Let's Encrypt. The mail server reads the certificate from
	# Caddy's storage, at a path that includes the name of the company that
	# issued it, so it must always be the same company.
	tls {
		issuer acme
	}

	reverse_proxy webmail:80

	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000"
		# The login page is not for search engines.
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
	}
}
