# Copy to .env and adjust. Only POSTGRES_PASSWORD is required.

# --- Database -------------------------------------------------------------
POSTGRES_DB=guheadlines
POSTGRES_USER=guheadlines
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Outside Docker you can instead give a full URL:
# DATABASE_URL=postgresql://guheadlines:password@localhost:5432/guheadlines

# --- Website --------------------------------------------------------------
WEB_PORT=8000
SITE_NAME=GU Headlines
SITE_TAGLINE=Guam news, updated every hour
PAGE_SIZE=30

# --- Scraper --------------------------------------------------------------
# How often to check the sources (minutes). Runs are aligned to the clock,
# so 60 means at the top of every hour.
SCRAPE_INTERVAL_MINUTES=60
# Also scrape immediately when the worker starts.
SCRAPE_ON_START=true
# Max new article pages fetched per source per run; the rest wait for the next run.
MAX_NEW_PER_SOURCE=40
# Seconds between requests to the same site, and sources scraped in parallel.
PER_HOST_DELAY=1.5
SCRAPER_WORKERS=4
REQUEST_TIMEOUT=25
RESPECT_ROBOTS_TXT=true
# Some sites block unknown bots; identify yourself with a contact URL/email.
# SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; GUHeadlinesBot/1.0; +mailto:you@example.com)

# --- Images ---------------------------------------------------------------
# Keep a resized WebP copy of each story's main image (so old stories keep
# their pictures). Set to false to hotlink the publisher's image instead.
STORE_IMAGES=true
IMAGE_MAX_WIDTH=720

LOG_LEVEL=INFO
